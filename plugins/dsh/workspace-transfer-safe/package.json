{
  "name": "@mainframe/dsh-workspace-transfer-safe",
  "version": "0.1.4",
  "description": "Move closed conversations between projects by verified copy and archive, without deletion",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {"dsh": ">=0.2.2-rc.1 <0.2.3-0"},
  "exports": {".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"},
  "files": ["index.js", "selftest.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {"platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-workspace-controller", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-context-menu"]}
  }
}
