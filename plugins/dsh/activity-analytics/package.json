{
  "name": "@mainframe/activity-analytics",
  "version": "1.3.5",
  "description": "Profile-wide local analytics for user activity and summed agent working time",
  "private": true,
  "type": "module",
  "engines": {"dsh": "0.2.2-rc.1"},
  "exports": {".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"},
