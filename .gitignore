# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
*.swp
*.swo

# Claude Code project-local config
.claude/
.claude/settings.local.json

# Local agent and Codex project state
/.agents/
/.codex/

# Python venv (local toolchain — tiktoken, pyyaml)
.venv/
__pycache__/
*.pyc
.ruff_cache/
.mypy_cache/

# OS temp
*~

# install.sh backup files (may contain references to private project paths)
*.backup
*.backup-*
*.bak

# Personal scratch (private)
todo

# Project-name blacklist (per-fork; contains private project identifiers).
# Template lives at tools/agnostic-blacklist.txt.example.
tools/agnostic-blacklist.txt

# Project-internal CLAUDE.md (development context for the hub maintainer)
# The shipped CLAUDE.md is dist/claude-code/CLAUDE.md and IS published.
/CLAUDE.md
# Local Codex mirror of the maintainer CLAUDE.md (symlink → /CLAUDE.md), not published.
/AGENTS.md

# Private documents (only docs/layers/ is published)
docs/*
!docs/installer-strategy.md
!docs/layers/
!docs/tickets/
!docs/tickets/**

# Hub-development workspace — queue (inbox), used-for-hub sources (reference),
# rejected/kept project artifacts (archive). All local, never published.
workspace/

# Derived OpenCode agent projection; committed goldens remain tracked.
dist/opencode/agents/
/dist/opencode/bundle-v2/

# Derived Codex projection; composed AGENTS.md and representative goldens are committed.
dist/codex/*
!dist/codex/AGENTS.md
!dist/codex/skills-golden/
!dist/codex/skills-golden/**

# Derived standalone Antigravity 2.x desktop plugin projection.
dist/antigravity-2/

# Derived standalone ZCode Desktop projection and closed bundle.
dist/zcode-desktop/bundle-v2/

# Direct bundle publication state; never part of a release payload.
dist/**/.*.publication.lock
dist/**/.*.publication.json
dist/**/.*.publication.json.tmp-*
dist/**/.*.staging-*
dist/**/.*.retained-*
