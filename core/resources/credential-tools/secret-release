#!/usr/bin/env bash
set -eu

MAINFRAME_COMMAND="$(dirname "$0")/mainframe"
if [ ! -x "$MAINFRAME_COMMAND" ]; then
    MAINFRAME_COMMAND="$(dirname "$0")/../../bin/mainframe"
fi
if [ ! -x "$MAINFRAME_COMMAND" ]; then
    echo "secret: mainframe executable is unavailable" >&2
    exit 1
fi
exec "$MAINFRAME_COMMAND" _secret-store "$@"
