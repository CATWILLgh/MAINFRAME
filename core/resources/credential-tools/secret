#!/usr/bin/env bash
# secret — personal secrets manager.
#
# Stores KEY=VALUE entries in ~/.config/credentials/secrets.env (mode 0600).
# Cross-platform: macOS and Linux, no external dependencies.

set -eu

SECRETS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/credentials"
SECRETS_FILE="$SECRETS_DIR/secrets.env"
BACKUP_FILE="$SECRETS_FILE.bak"
LOCKDIR="$SECRETS_DIR/.lock"
MAX_STDIN_VALUE_BYTES=$((16 * 1024))
STDIN_VALUE=

reject_unsafe_store() {
    echo "secret: credential store is unsafe" >&2
    return 1
}

ensure_store_directory() {
    if [ -L "$SECRETS_DIR" ]; then
        reject_unsafe_store
        return 1
    fi
    if [ ! -e "$SECRETS_DIR" ]; then
        mkdir -p "$SECRETS_DIR"
        chmod 700 "$SECRETS_DIR"
    fi
    if [ ! -d "$SECRETS_DIR" ]; then
        reject_unsafe_store
        return 1
    fi
}

ensure_store_file() {
    if [ -L "$SECRETS_FILE" ] || [ -L "$BACKUP_FILE" ]; then
        reject_unsafe_store
        return 1
    fi
    if [ ! -e "$SECRETS_FILE" ]; then
        ( umask 077; : > "$SECRETS_FILE" )
    fi
    if [ ! -f "$SECRETS_FILE" ] || ! chmod 600 "$SECRETS_FILE"; then
        reject_unsafe_store
        return 1
    fi
}

ensure_store() {
    ensure_store_directory
    ensure_store_file
}

acquire_lock() {
    local n=0
    while ! mkdir "$LOCKDIR" 2>/dev/null; do
        local pid
        pid=$(cat "$LOCKDIR/pid" 2>/dev/null || true)
        if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
            rm -rf "$LOCKDIR"
            continue
        fi
        n=$((n + 1))
        if [ "$n" -gt 50 ]; then
            echo "secret: another instance holds the lock (waited 5s, giving up)" >&2
            return 1
        fi
        sleep 0.1
    done
    echo $$ > "$LOCKDIR/pid"
}

release_lock() {
    rm -rf "$LOCKDIR" 2>/dev/null || true
}

validate_name() {
    case "$1" in
        '')
            echo "secret: empty name" >&2; return 1 ;;
        [0-9]*)
            echo "secret: name '$1' cannot start with a digit" >&2; return 1 ;;
        *[!A-Z0-9_]*)
            echo "secret: name '$1' must match [A-Z_][A-Z0-9_]* (uppercase, digits, underscore)" >&2; return 1 ;;
    esac
}

escape_value() {
    printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

unescape_value() {
    printf "%s" "$1" | sed "s/'\\\\''/'/g"
}

write_store_atomically() {
    local source_content="$1"
    local primary_tmp backup_tmp
    if [ -L "$SECRETS_FILE" ] || [ -L "$BACKUP_FILE" ]; then
        reject_unsafe_store
        return 1
    fi
    primary_tmp=$(mktemp "$SECRETS_DIR/.secrets.XXXXXX")
    backup_tmp=$(mktemp "$SECRETS_DIR/.secrets-backup.XXXXXX")
    chmod 600 "$primary_tmp" "$backup_tmp"
    trap 'rm -f "$primary_tmp" "$backup_tmp"; release_lock' EXIT INT TERM

    printf "%s" "$source_content" > "$primary_tmp"
    printf "%s" "$source_content" > "$backup_tmp"
    if ! sh -n "$primary_tmp" 2>/dev/null; then
        echo "secret: refusing to write malformed file (sh -n failed)" >&2
        return 1
    fi

    mv "$backup_tmp" "$BACKUP_FILE"
    mv "$primary_tmp" "$SECRETS_FILE"
    trap - EXIT INT TERM
}

reject_stdin_value() {
    echo "secret: stdin value is invalid" >&2
    return 1
}

read_stdin_value() {
    local input_file byte_count
    input_file=$(mktemp "${TMPDIR:-/tmp}/secret-stdin.XXXXXX" 2>/dev/null) || {
        reject_stdin_value
        return 1
    }
    trap 'rm -f "$input_file"' EXIT INT TERM
    if ! chmod 600 "$input_file" || ! LC_ALL=C head -c "$((MAX_STDIN_VALUE_BYTES + 1))" > "$input_file"; then
        rm -f "$input_file"
        trap - EXIT INT TERM
        reject_stdin_value
        return 1
    fi

    byte_count=$(LC_ALL=C wc -c < "$input_file")
    if [ "$byte_count" -gt "$MAX_STDIN_VALUE_BYTES" ] ||
        LC_ALL=C od -An -v -t x1 "$input_file" |
            grep -Eq '(^|[[:space:]])(00|0a|0d)([[:space:]]|$)'; then
        rm -f "$input_file"
        trap - EXIT INT TERM
        reject_stdin_value
        return 1
    fi

    exec 3< "$input_file"
    IFS= read -r STDIN_VALUE <&3 || true
    exec 3<&-
    rm -f "$input_file"
    trap - EXIT INT TERM
    if [ -z "$STDIN_VALUE" ]; then
        reject_stdin_value
        return 1
    fi
}

cmd_set() {
    if [ "$#" -ne 2 ]; then
        echo "Usage: secret set NAME VALUE" >&2; return 2
    fi
    validate_name "$1"
    case "$2" in
        *$'\n'*)
            echo "secret: value contains a newline; multi-line values are not supported." >&2
            return 1
            ;;
    esac
    local name="$1" value="$2" existing new_line body
    ensure_store
    acquire_lock || return 1
    trap 'release_lock' EXIT INT TERM
    existing=$(grep -v "^${name}=" "$SECRETS_FILE" 2>/dev/null || true)
    new_line=$(printf "%s='%s'" "$name" "$(escape_value "$value")")
    if [ -n "$existing" ]; then
        body="$existing
$new_line
"
    else
        body="$new_line
"
    fi
    write_store_atomically "$body" || return 1
    release_lock
    trap - EXIT INT TERM
}

cmd_create_stdin() {
    if [ "$#" -ne 1 ]; then
        echo "Usage: secret create-stdin NAME" >&2; return 2
    fi
    validate_name "$1"
    read_stdin_value || return 1
    local name="$1" existing new_line body
    ensure_store_directory || return 1
    acquire_lock || return 1
    trap 'release_lock' EXIT INT TERM
    ensure_store_file || return 1
    if grep -q "^${name}=" "$SECRETS_FILE" 2>/dev/null; then
        echo "secret: stdin secret cannot replace an existing entry" >&2
        release_lock
        trap - EXIT INT TERM
        return 1
    fi
    existing=$(cat "$SECRETS_FILE" 2>/dev/null || true)
    new_line=$(printf "%s='%s'" "$name" "$(escape_value "$STDIN_VALUE")")
    if [ -n "$existing" ]; then
        body="$existing
$new_line
"
    else
        body="$new_line
"
    fi
    write_store_atomically "$body" || return 1
    release_lock
    trap - EXIT INT TERM
}

cmd_get() {
    if [ "$#" -ne 1 ]; then
        echo "Usage: secret get NAME" >&2; return 2
    fi
    validate_name "$1"
    ensure_store
    local line value
    line=$(grep "^$1=" "$SECRETS_FILE" 2>/dev/null | tail -1 || true)
    if [ -z "$line" ]; then
        echo "secret: no entry for '$1'" >&2
        return 1
    fi
    value="${line#*=}"
    case "$value" in
        \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    unescape_value "$value"
}

cmd_del() {
    if [ "$#" -ne 1 ]; then
        echo "Usage: secret del NAME" >&2; return 2
    fi
    validate_name "$1"
    ensure_store
    acquire_lock || return 1
    trap 'release_lock' EXIT INT TERM
    if ! grep -q "^$1=" "$SECRETS_FILE" 2>/dev/null; then
        echo "secret: no entry for '$1' (nothing to delete)" >&2
        release_lock
        trap - EXIT INT TERM
        return 0
    fi
    local body
    body=$(grep -v "^$1=" "$SECRETS_FILE" 2>/dev/null || true)
    body="$body
"
    write_store_atomically "$body" || return 1
    release_lock
    trap - EXIT INT TERM
}

cmd_list() {
    ensure_store
    grep -E "^[A-Z_][A-Z0-9_]*=" "$SECRETS_FILE" 2>/dev/null |
        cut -d= -f1 | sort -u || true
}

cmd_edit() {
    ensure_store
    : "${EDITOR:=${VISUAL:-vi}}"
    acquire_lock || return 1
    trap 'release_lock' EXIT INT TERM
    local edit_tmp body
    edit_tmp=$(mktemp "$SECRETS_DIR/.secrets-edit.XXXXXX")
    chmod 600 "$edit_tmp"
    cp "$SECRETS_FILE" "$edit_tmp"
    "$EDITOR" "$edit_tmp"
    if ! sh -n "$edit_tmp" 2>/dev/null; then
        rm -f "$edit_tmp"
        echo "secret: edited file is malformed (sh -n failed)" >&2
        return 1
    fi
    body=$(cat "$edit_tmp")
    body="$body
"
    rm -f "$edit_tmp"
    write_store_atomically "$body" || return 1
    release_lock
    trap - EXIT INT TERM
}

cmd_help() {
    cat <<'EOF'
secret — personal secrets manager (file-based, cross-platform)

Usage:
  secret set NAME VALUE       add or replace a secret
  secret create-stdin NAME    create a secret from standard input (no overwrite)
  secret get NAME             print a value (use inline: $(secret get NAME))
  secret del NAME             delete a secret
  secret list                 show all names (no values)
  secret edit                 open store in $EDITOR
  secret help                 this message

Storage:  ${XDG_CONFIG_HOME:-$HOME/.config}/credentials/secrets.env  (mode 0600)
Backup:   ${XDG_CONFIG_HOME:-$HOME/.config}/credentials/secrets.env.bak  (mode 0600)
For credential discovery, run `mainframe credentials` first.
Adapter-local credentials indexes are read-only migration fallbacks.
EOF
}

case "${1:-help}" in
    set) shift; cmd_set "$@" ;;
    create-stdin) shift; cmd_create_stdin "$@" ;;
    get) shift; cmd_get "$@" ;;
    del) shift; cmd_del "$@" ;;
    list) cmd_list ;;
    edit) cmd_edit ;;
    help|-h|--help) cmd_help ;;
    *) echo "secret: unknown command '$1' — try 'secret help'" >&2; exit 2 ;;
esac
