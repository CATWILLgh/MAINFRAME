{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence", "candidates"],
  "properties": {
    "evidence": {
      "type": "array", "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "value"],
        "properties": {
          "path": {"type": "string", "pattern": "^/"},
          "value": {"type": ["string", "number", "integer", "boolean", "null"]}
        }
      }
    },
    "candidates": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "hypothesis", "evidence_paths", "confidence", "next_probe"],
        "properties": {
          "category": {"type": "string", "enum": ["noisy-injection", "model-lab-cost", "hook-efficiency", "data-gap"]},
          "hypothesis": {"type": "string", "minLength": 1, "maxLength": 500},
          "evidence_paths": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "pattern": "^/"}},
          "confidence": {"type": "string", "enum": ["low", "medium"]},
          "next_probe": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    }
  }
}
