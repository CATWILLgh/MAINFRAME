{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "SessionStart",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/hooklib-smoke-check.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-telemetry-hook.sh",
              "SessionStart",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "SessionStart",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/init-reminder.py"
            ]
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^mainframe:.*$",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-telemetry-hook.sh",
              "UserPromptExpansion",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry.py"
            ]
          }
        ]
      },
      {
        "matcher": "mainframe:init",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "UserPromptExpansion",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/init-reminder.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "UserPromptSubmit",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/init-reminder.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-telemetry-hook.sh",
              "UserPromptSubmit",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry.py"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PreToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/length-quality-note.py"
            ]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PreToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/path-validation.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PreToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-authority.py"
            ],
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PreToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/git-authority.py"
            ],
            "if": "Bash(*/*git *)"
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PreToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/secret-commit-gate.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PreToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/bash-pattern-reminder.py"
            ]
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PreToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/skill-authority.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-telemetry-hook.sh",
              "PreToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry.py"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PostToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/scan-suppression-markers.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PostToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/comment-discipline-reminder.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PostToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/python-security-scan.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PostToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/nodejs-security-scan.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PostToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/fallow-quality-note.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PostToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/length-quality-note.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-telemetry-hook.sh",
              "PostToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry.py"
            ]
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "PostToolUse",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/ticket-id-format-reminder.py"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "Stop",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-gate-suppression-markers.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "Stop",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-gate-comment-discipline.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "Stop",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/python-security-stop-gate.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "Stop",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/fallow-quality-note.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "Stop",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/length-quality-note.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "Stop",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/memory-reminder.py"
            ]
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-telemetry-hook.sh",
              "PermissionDenied",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry.py"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "mainframe-advisor",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "SubagentStart",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/advisor-context.py"
            ]
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-telemetry-hook.sh",
              "SubagentStart",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry.py"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "SubagentStop",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-gate-suppression-markers.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "SubagentStop",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/stop-gate-comment-discipline.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-hook.sh",
              "SubagentStop",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/python-security-stop-gate.py"
            ]
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-telemetry-hook.sh",
              "SubagentStop",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry.py"
            ]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-telemetry-hook.sh",
              "PostCompact",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry.py"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/run-telemetry-hook.sh",
              "SessionEnd",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/telemetry.py"
            ]
          }
        ]
      }
    ]
  }
}
