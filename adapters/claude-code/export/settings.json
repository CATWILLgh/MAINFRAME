{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 3650,
  "env": {},
  "permissions": {
    "allow": [
      "Bash(secret get *)",
      "Read(~/.claude/credentials-index.md)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:gist.github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:context7.io)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:pypi.org)",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Agent(general-purpose)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./)",
      "Bash(rm -rf /etc*)",
      "Bash(rm -rf /usr*)",
      "Bash(rm -rf /var*)",
      "Bash(rm -rf /bin*)",
      "Bash(rm -rf /sbin*)",
      "Bash(rm -rf /boot*)",
      "Bash(rm -rf /lib*)",
      "Bash(rm -rf /opt*)",
      "Bash(rm -rf /System*)",
      "Bash(rm -rf /Library*)",
      "Bash(rm -rf /Applications*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f *)",
      "Bash(*git push --force-with-lease*)",
      "Bash(secret set *)",
      "Bash(secret del *)",
      "Bash(secret edit *)",
      "Bash(secret list *)",
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git rebase --no-verify*)",
      "Bash(*git commit -n *)",
      "Bash(npm install --no-verify*)",
      "Bash(pnpm install --no-verify*)",
      "Bash(mkfs *)",
      "Bash(mkfs.* *)",
      "Bash(/sbin/mkfs *)",
      "Bash(/sbin/mkfs.* *)",
      "Bash(/usr/sbin/mkfs *)",
      "Bash(/usr/sbin/mkfs.* *)",
      "Bash(dd *if=*)",
      "Bash(/bin/dd *if=*)",
      "Bash(/usr/bin/dd *if=*)",
      "Bash(fdisk *)",
      "Bash(/sbin/fdisk *)",
      "Bash(/usr/sbin/fdisk *)",
      "Bash(curl *|*sh*)",
      "Bash(curl *|*bash*)",
      "Bash(curl *|*zsh*)",
      "Bash(curl *|*python*)",
      "Bash(curl *|*node*)",
      "Bash(wget *|*sh*)",
      "Bash(wget *|*bash*)",
      "Bash(wget *|*zsh*)",
      "Bash(wget *|*python*)",
      "Bash(*> ~/.bashrc*)",
      "Bash(*>> ~/.bashrc*)",
      "Bash(*> ~/.zshrc*)",
      "Bash(*>> ~/.zshrc*)",
      "Bash(*> ~/.bash_profile*)",
      "Bash(*>> ~/.bash_profile*)",
      "Bash(*> ~/.profile*)",
      "Bash(*>> ~/.profile*)",
      "Bash(*> ~/.gitconfig*)",
      "Bash(*>> ~/.gitconfig*)",
      "Bash(*> ~/.npmrc*)",
      "Bash(*>> ~/.npmrc*)",
      "Bash(chmod -R 777 *)",
      "Bash(/bin/chmod -R 777 *)",
      "Bash(/usr/bin/chmod -R 777 *)",
      "Bash(chmod 777 /*)",
      "Bash(/bin/chmod 777 /*)",
      "Bash(/usr/bin/chmod 777 /*)",
      "Bash(chmod -R 000 *)",
      "Bash(/bin/chmod -R 000 *)",
      "Bash(/usr/bin/chmod -R 000 *)",
      "Bash(chown -R root*)",
      "Bash(/usr/sbin/chown -R root*)",
      "Bash(/bin/chown -R root*)",
      "Bash(/usr/bin/chown -R root*)",
      "Bash(kill -9 1)",
      "Bash(kill -9 1 *)",
      "Bash(/bin/kill -9 1)",
      "Bash(/bin/kill -9 1 *)",
      "Bash(/usr/bin/kill -9 1)",
      "Bash(/usr/bin/kill -9 1 *)",
      "Bash(kill -9 -1)",
      "Bash(kill -9 -1 *)",
      "Bash(/bin/kill -9 -1)",
      "Bash(/bin/kill -9 -1 *)",
      "Bash(/usr/bin/kill -9 -1)",
      "Bash(/usr/bin/kill -9 -1 *)",
      "Bash(iptables -F*)",
      "Bash(ufw --force reset*)",
      "Bash(ufw reset*)",
      "Bash(systemctl stop auditd*)",
      "Bash(systemctl disable auditd*)",
      "Bash(unset HISTFILE*)",
      "Read(**/.env.production)",
      "Read(**/.env.production.*)",
      "Read(**/.env.prod)",
      "Read(**/.env.prod.*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/**)",
      "Read(~/.netrc)",
      "Read(~/.config/credentials/**)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Bash(*~/.ssh/id_*)",
      "Bash(*~/.ssh/authorized_keys*)",
      "Bash(*~/.aws/credentials*)",
      "Bash(*~/.netrc*)",
      "Bash(*~/.config/credentials/*)",
      "Bash(*/.config/credentials/*)",
      "Bash(*~/.gnupg/*)",
      "Bash(*~/.kube/config*)",
      "Bash(*~/.docker/config.json*)",
      "Bash(*~/.npmrc*)",
      "Bash(*/etc/shadow*)",
      "Bash(*/etc/sudoers*)"
