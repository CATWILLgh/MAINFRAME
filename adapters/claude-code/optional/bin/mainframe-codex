#!/usr/bin/env python3
"""Run one persistent Codex peer session with a stable new/resume contract."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile


VALID_EFFORTS = {"low", "medium", "high", "xhigh", "max"}
MAX_REQUEST_BYTES = 512_000


def _claude_root() -> Path:
    return Path(os.environ.get("CLAUDE_CONFIG_DIR") or "~/.claude").expanduser().resolve()


def _session_path(session_id: str) -> Path:
    return _claude_root() / "mainframe" / "peer-sessions" / "codex" / f"{session_id}.json"


def _project_key(project: Path) -> str:
    return hashlib.sha256(str(project).encode()).hexdigest()[:24]


def _atomic_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
    temporary.chmod(0o600)
    os.replace(temporary, path)


def _pid_alive(raw: object) -> bool:
    if not isinstance(raw, int) or raw <= 0:
        return False
    try:
        os.kill(raw, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _implementation_lock_path(project: Path) -> Path:
    return (
        _claude_root() / "mainframe" / "peer-locks" / "codex"
        / f"{_project_key(project)}.json"
    )


def _acquire_implementation_lock(project: Path) -> Path:
    path = _implementation_lock_path(project)
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    for _attempt in range(2):
        try:
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            try:
                owner = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                owner = {}
            if isinstance(owner, dict) and _pid_alive(owner.get("pid")):
                raise ValueError("another Codex implementation peer is active in this project")
            path.unlink(missing_ok=True)
            continue
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump({"schemaVersion": 1, "pid": os.getpid()}, handle)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        return path
    raise ValueError("could not acquire the Codex implementation peer lock")


def _release_implementation_lock(path: Path) -> None:
    try:
        owner = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return
    if isinstance(owner, dict) and owner.get("pid") == os.getpid():
        path.unlink(missing_ok=True)


def _request(path: str) -> Path:
    value = Path(path).expanduser().resolve()
    if not value.is_file():
        raise ValueError(f"request file does not exist: {value}")
    if value.stat().st_size > MAX_REQUEST_BYTES:
        raise ValueError("request file is larger than 512 KB")
    return value


def _project(path: str) -> Path:
    value = Path(path).expanduser().resolve()
    if not value.is_dir():
        raise ValueError(f"project directory does not exist: {value}")
    return value


def _thread_id(events: Path) -> str | None:
    for line in events.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if row.get("type") == "thread.started" and isinstance(row.get("thread_id"), str):
            return row["thread_id"]
    return None


def _load_session(session_id: str) -> dict:
    path = _session_path(session_id)
    if not path.is_file():
        raise ValueError(
            "unknown peer session; resume only a session created by mainframe-codex"
        )
    value = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(value, dict) or value.get("schemaVersion") != 1:
        raise ValueError("peer session metadata is invalid")
    return value


def _run(args: argparse.Namespace) -> int:
    project = _project(args.project)
    request = _request(args.request)
    if args.action == "new":
        role = args.role
        access = "read-only" if role == "review" else args.access
        model = args.model
        effort = args.effort
        session = None
    else:
        metadata = _load_session(args.session)
        if Path(metadata["projectRoot"]).resolve() != project:
            raise ValueError("the resumed peer session belongs to a different project")
        role = metadata["role"]
        access = metadata["access"]
        model = args.model or metadata["model"]
        effort = args.effort or metadata["effort"]
        session = args.session

    implementation_lock = (
        _acquire_implementation_lock(project) if role == "implement" else None
    )
    try:
        with tempfile.TemporaryDirectory(prefix="mainframe-codex-peer-") as raw:
            temporary = Path(raw)
            events = temporary / "events.jsonl"
            answer = temporary / "answer.md"
            diagnostics = temporary / "diagnostics.log"
            if args.action == "new":
                command = ["codex", "exec", "--strict-config", "-C", str(project)]
            else:
                command = ["codex", "exec", "resume", "--strict-config", session]
            command.extend([
                "-m", model,
                "-c", f'model_reasoning_effort="{effort}"',
                "--json",
                "-o", str(answer),
            ])
            if role == "review":
                command.extend(["-c", 'sandbox_mode="read-only"', "-c", 'approval_policy="never"'])
            elif access == "full":
                command.extend(["-c", 'sandbox_mode="danger-full-access"', "-c", 'approval_policy="never"'])
            elif args.action == "new":
                command.append("--approve-for-me")
            command.append("-")

            with request.open("rb") as source, events.open("wb") as out, diagnostics.open("wb") as err:
                completed = subprocess.run(
                    command,
                    cwd=project,
                    stdin=source,
                    stdout=out,
                    stderr=err,
                    check=False,
                )
            thread_id = _thread_id(events)
            if thread_id:
                _atomic_json(_session_path(thread_id), {
                    "schemaVersion": 1,
                    "sessionId": thread_id,
                    "projectRoot": str(project),
                    "role": role,
                    "access": access,
                    "model": model,
                    "effort": effort,
                })
            if completed.returncode != 0 or not thread_id or not answer.is_file():
                detail = diagnostics.read_text(encoding="utf-8", errors="replace")[-4000:]
                print("Codex peer run failed.", file=sys.stderr)
                if thread_id:
                    print(f"peer_session_id={thread_id}", file=sys.stderr)
                if detail.strip():
                    print(detail.strip(), file=sys.stderr)
                return completed.returncode or 1
            result = answer.read_text(encoding="utf-8", errors="replace")
            print(f"peer_session_id={thread_id}")
            print(f"peer_role={role}")
            print(f"peer_model={model}")
            print(f"peer_effort={effort}")
            print("---")
            print(result.rstrip())
            return 0
    finally:
        if implementation_lock is not None:
            _release_implementation_lock(implementation_lock)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Run or resume a Codex peer review or implementation session."
    )
    subparsers = parser.add_subparsers(dest="action", required=True)
    new = subparsers.add_parser("new")
    new.add_argument("--role", choices=("review", "implement"), required=True)
    new.add_argument("--project", required=True)
    new.add_argument("--request", required=True)
    new.add_argument("--model", required=True)
    new.add_argument("--effort", choices=sorted(VALID_EFFORTS), required=True)
    new.add_argument("--access", choices=("auto", "full"), default="auto")
    resume = subparsers.add_parser("resume")
    resume.add_argument("--session", required=True)
    resume.add_argument("--project", required=True)
    resume.add_argument("--request", required=True)
    resume.add_argument("--model")
    resume.add_argument("--effort", choices=sorted(VALID_EFFORTS))
    return parser


def main() -> int:
    try:
        return _run(_parser().parse_args())
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
