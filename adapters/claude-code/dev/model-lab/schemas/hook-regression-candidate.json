{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "evidence", "recommended_test", "confidence", "limitations"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "evidence": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["location", "observation"],
        "properties": {
          "location": {"type": "string", "minLength": 1, "maxLength": 300},
          "observation": {"type": "string", "minLength": 1, "maxLength": 800}
        }
      }
    },
    "recommended_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "purpose", "setup", "action", "assertions"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
        "setup": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 500}},
        "action": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 500}},
        "assertions": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "maxLength": 500}}
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 500}
    }
  }
}
