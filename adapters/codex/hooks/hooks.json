{
  "description": "MAINFRAME lifecycle, quality, safety, and development telemetry hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5,
            "statusMessage": "MAINFRAME: checking session setup",
            "additionalContextLimit": 700
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 3,
            "statusMessage": "MAINFRAME: recording session end"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5,
            "statusMessage": "MAINFRAME: recording subagent start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Edit|Write|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 15,
            "statusMessage": "MAINFRAME: checking command or edit",
            "additionalContextLimit": 900
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5,
            "statusMessage": "MAINFRAME: recording permission request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 30,
            "statusMessage": "MAINFRAME: reviewing current edit",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5,
            "statusMessage": "MAINFRAME: recording compaction"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5,
            "statusMessage": "MAINFRAME: recording prompt metadata"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 210,
            "statusMessage": "MAINFRAME: checking current-session findings"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 30,
            "statusMessage": "MAINFRAME: checking subagent findings"
          }
        ]
      }
    ]
  }
}
