{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5,
            "additionalContextLimit": 700
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|Edit|Write|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 15,
            "additionalContextLimit": 900
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 30,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 210
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B @MAINFRAME_HOOK_SCRIPT@",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
