# MAINFRAME blocks only Git plumbing that bypasses ordinary reviewed commands.
# User-facing authority and approval remain owned by the active native Codex
# permission mode plus the primary-session instructions. In particular, do not
# add `prompt` rules here: native Full access runs with approvals disabled, so a
# prompt rule becomes a hard denial even after the user explicitly authorizes
# the action.

prefix_rule(
    pattern = ["git", ["commit-tree", "send-pack"]],
    decision = "forbidden",
    justification = "Use the reviewed high-level `git commit` or non-force `git push` path; these plumbing commands bypass its verification and authority checks.",
    match = [
        "git commit-tree deadbeef -m example",
        "git send-pack origin refs/heads/main",
    ],
    not_match = [
        "git commit -m example",
        "git push origin main",
    ],
)
