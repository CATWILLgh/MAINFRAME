# MAINFRAME Git authority guardrails.
#
# These rules route repository operations that require separate user authority
# through Codex approval handling. With auto-review enabled, the reviewer can
# approve an explicitly requested operation without interrupting the user.
# The built-in :workspace profile deliberately keeps .git read-only. Ordinary
# primary-session delivery therefore uses prompt rules: auto-review can grant
# the narrow command escalation without making all Git metadata writable.

prefix_rule(
    pattern = ["git", ["add", "stage", "commit", "rm", "mv"]],
    decision = "prompt",
    justification = "Primary-session staging and ordinary local commits need reviewed access to protected Git metadata; hooks still block subagent delivery, verification bypasses, and history-changing variants.",
    match = [
        "git add README.md",
        "git stage adapters/codex",
        "git commit -m feat: example",
        "git rm obsolete.txt",
        "git mv old.txt new.txt",
    ],
    not_match = [
        "git status --short",
        "git push origin main",
    ],
)

prefix_rule(
    pattern = ["secret"],
    decision = "prompt",
    justification = "Credential access must pass auto-review and keep secret values out of the model context.",
    match = [
        "secret list",
        "secret env service credential -- command --flag",
    ],
    not_match = [
        "security find-generic-password -a example",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Push only when the user explicitly requested remote delivery; ordinary push authority does not include force push.",
    match = [
        "git push",
        "git push origin main",
        "git push --set-upstream origin feature/example",
    ],
    not_match = [
        "git status",
        "git remote -v",
    ],
)

prefix_rule(
    pattern = ["git", ["switch", "checkout", "pull", "merge", "rebase", "reset", "cherry-pick", "revert", "restore"]],
    decision = "prompt",
    justification = "Changing the branch, worktree, index, or history requires an explicit user request.",
    match = [
        "git switch feature/example",
        "git checkout main",
        "git pull --ff-only",
        "git merge feature/example",
        "git rebase main",
        "git reset --soft HEAD~1",
        "git cherry-pick deadbeef",
        "git revert deadbeef",
        "git restore src/example.ts",
    ],
    not_match = [
        "git status --short --branch",
        "git diff --check",
        "git log -1 --oneline",
    ],
)

prefix_rule(
    pattern = ["git", "commit", "--amend"],
    decision = "prompt",
    justification = "Amending history requires an explicit user request; create a new local commit otherwise.",
    match = [
        "git commit --amend",
        "git commit --amend --no-edit",
    ],
    not_match = [
        "git commit -m feat: example",
    ],
)

prefix_rule(
    pattern = ["git", "stash", ["push", "pop", "apply", "drop", "clear", "branch", "save"]],
    decision = "prompt",
    justification = "Changing stash state requires an explicit user request; listing or showing stashes remains ordinary inspection.",
    match = [
        "git stash push -m checkpoint",
        "git stash pop",
        "git stash clear",
    ],
    not_match = [
        "git stash list",
        "git stash show stash@{0}",
    ],
)

prefix_rule(
    pattern = ["git", "worktree", ["add", "move", "remove", "lock", "unlock", "prune", "repair"]],
    decision = "prompt",
    justification = "Changing worktrees requires an explicit user request; listing worktrees remains ordinary inspection.",
    match = [
        "git worktree add ../example feature/example",
        "git worktree remove ../example",
        "git worktree prune",
    ],
    not_match = [
        "git worktree list",
    ],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Deleting untracked files requires an explicit user request. A dry run may be approved as inspection.",
    match = [
        "git clean -n",
        "git clean -fd",
    ],
    not_match = [
        "git status --short",
    ],
)

prefix_rule(
    pattern = ["git", "branch", ["-d", "-D", "-m", "-M", "-c", "-C", "--delete", "--move", "--copy", "--force", "--edit-description", "--set-upstream-to", "--unset-upstream", "--create-reflog", "--track", "--no-track"]],
    decision = "prompt",
    justification = "Creating, deleting, renaming, or retargeting a branch requires an explicit user request.",
    match = [
        "git branch -d old-branch",
        "git branch -m new-name",
        "git branch --set-upstream-to origin/main",
    ],
    not_match = [
        "git branch --show-current",
        "git branch --list",
        "git branch -a",
    ],
)

prefix_rule(
    pattern = [["rm", "/bin/rm"], ["-r", "-R", "-rf", "-rF", "-fr", "-fR", "-Rf", "-RF", "--recursive"]],
    decision = "prompt",
    justification = "Recursive deletion requires review of the resolved target; ordinary non-recursive file deletion remains available.",
    match = [
        "rm -rf build/cache",
        "/bin/rm -R generated",
    ],
    not_match = [
        "rm one-file.txt",
        "rmdir empty-directory",
    ],
)
