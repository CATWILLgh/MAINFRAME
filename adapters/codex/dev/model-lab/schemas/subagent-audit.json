{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "complexity", "work_type", "outcome", "execution", "evidence", "limitations"],
  "properties": {
    "task": {"type": "string", "minLength": 1, "maxLength": 500},
    "complexity": {"type": "string", "enum": ["small", "medium", "large", "unknown"]},
    "work_type": {"type": "string", "enum": ["exploration", "research", "implementation", "review", "testing", "other", "unknown"]},
    "outcome": {"type": "string", "enum": ["completed", "partial", "blocked", "cancelled", "unknown"]},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turns", "tool_calls", "repeated_actions", "assessment"],
      "properties": {
        "turns": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "repeated_actions": {"type": "integer", "minimum": 0},
        "assessment": {"type": "string", "enum": ["efficient", "mixed", "wasteful", "unknown"]}
      }
    },
    "evidence": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "limitations": {
      "type": "array", "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 400}
    }
  }
}
