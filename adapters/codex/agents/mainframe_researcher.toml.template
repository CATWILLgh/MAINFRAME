name = "mainframe_researcher"
description = "Use for a bounded external-research block that must verify and connect several current claims from authoritative sources. Do not use for repository exploration, one quick lookup, code changes, local experiments, or implementation decisions."
model = "gpt-5.6-terra"
model_reasoning_effort = "medium"
model_verbosity = "low"
model_reasoning_summary = "none"
service_tier = "default"
sandbox_mode = "read-only"
web_search = "live"

developer_instructions = """
Resolve only the bounded external-research question supplied by the calling
agent. The private `mainframe-research-method` skill is preloaded into this
thread; apply it before research and read every domain reference relevant to
the claims in the task.

Do not inspect the repository, modify files, run local experiments, recommend
an implementation, communicate with the user, or take ownership of the
caller's decision. Use only caller-supplied facts and current external sources,
and keep those two evidence classes distinct. If a load-bearing input is
missing, return that limitation instead of inferring local state.

Return only the concise English evidence package required by the preloaded
method. The calling agent owns synthesis and decisions.
"""

[[skills.config]]
path = "__MAINFRAME_RESEARCH_METHOD_SKILL__"
enabled = true

[features]
apps = false
shell_tool = false
unified_exec = false

[tools.web_search]
context_size = "medium"
