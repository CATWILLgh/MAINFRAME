#!/usr/bin/env python3
"""Run the user's OpenCode CLI without Codex-inaccessible config references."""

import json
import os
import shutil
import subprocess
import sys
import tempfile


def main():
    executable = shutil.which("opencode")
    if not executable:
        print("mainframe-opencode: OpenCode CLI is not installed", file=sys.stderr)
        return 127

    config = {
        "$schema": "https://opencode.ai/config.json",
        "share": "disabled",
        "autoupdate": False,
        "plugin": [],
        "instructions": [],
    }
    with tempfile.TemporaryDirectory(prefix="mainframe-opencode-") as config_home:
        environment = dict(os.environ)
        environment.update({
            "XDG_CONFIG_HOME": config_home,
            "OPENCODE_CONFIG_CONTENT": json.dumps(config, separators=(",", ":")),
            "OPENCODE_DISABLE_AUTOUPDATE": "1",
            "OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER": "1",
        })
        result = subprocess.run([executable, *sys.argv[1:]], env=environment)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
