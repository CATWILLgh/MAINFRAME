#!/usr/bin/env bash
# Personal file-based secret command for macOS and Linux.
# MAINFRAME_SECRET_HELPER=2
# Secret values live outside the MAINFRAME repository.

set -eu

SECRETS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/credentials"
SECRETS_FILE="$SECRETS_DIR/secrets.env"
BACKUP_FILE="$SECRETS_FILE.bak"
LOCKDIR="$SECRETS_DIR/.lock"

ensure_store() {
    if [[ ! -d "$SECRETS_DIR" ]]; then
        mkdir -p "$SECRETS_DIR"
        chmod 700 "$SECRETS_DIR"
    fi
    if [[ ! -f "$SECRETS_FILE" ]]; then
        (umask 077; : > "$SECRETS_FILE")
    fi
    chmod 600 "$SECRETS_FILE" 2>/dev/null || true
}

acquire_lock() {
    local attempts=0 pid
    while ! mkdir "$LOCKDIR" 2>/dev/null; do
        pid=$(sed -n '1p' "$LOCKDIR/pid" 2>/dev/null || true)
        if [[ -n "$pid" ]] && ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$LOCKDIR/pid"
            rmdir "$LOCKDIR" 2>/dev/null || true
            continue
        fi
        attempts=$((attempts + 1))
        if [[ "$attempts" -gt 50 ]]; then
            echo "mainframe-secret: another instance holds the lock" >&2
            return 1
        fi
        sleep 0.1
    done
    printf '%s\n' "$$" > "$LOCKDIR/pid"
}

release_lock() {
    rm -f "$LOCKDIR/pid" 2>/dev/null || true
    rmdir "$LOCKDIR" 2>/dev/null || true
}

validate_name() {
    case "$1" in
        '')
            echo "mainframe-secret: empty name" >&2
            return 1
            ;;
        [0-9]*)
            echo "mainframe-secret: name '$1' cannot start with a digit" >&2
            return 1
            ;;
        *[!A-Z0-9_]*)
            echo "mainframe-secret: name '$1' must match [A-Z_][A-Z0-9_]*" >&2
            return 1
            ;;
    esac
}

escape_value() {
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
}

unescape_value() {
    printf '%s' "$1" | sed "s/'\\\\''/'/g"
}

write_store_atomically() {
    local body="$1" tmpfile
    tmpfile=$(mktemp "$SECRETS_DIR/.secrets.XXXXXX")
    chmod 600 "$tmpfile"
    trap 'rm -f "$tmpfile"; release_lock' EXIT INT TERM
    printf '%s' "$body" > "$tmpfile"
    if ! bash -n "$tmpfile" 2>/dev/null; then
        echo "mainframe-secret: refusing to write malformed store" >&2
        rm -f "$tmpfile"
        return 1
    fi
    cp -p "$SECRETS_FILE" "$BACKUP_FILE" 2>/dev/null || true
    mv "$tmpfile" "$SECRETS_FILE"
    trap - EXIT INT TERM
}

read_clipboard() {
    if command -v pbpaste >/dev/null 2>&1; then
        pbpaste
    elif command -v wl-paste >/dev/null 2>&1; then
        wl-paste --no-newline
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard -out
    elif command -v xsel >/dev/null 2>&1; then
        xsel --clipboard --output
    else
        echo "mainframe-secret: no supported clipboard reader is installed" >&2
        return 1
    fi
}

write_clipboard() {
    if command -v pbcopy >/dev/null 2>&1; then
        pbcopy
    elif command -v wl-copy >/dev/null 2>&1; then
        wl-copy
    elif command -v xclip >/dev/null 2>&1; then
        xclip -selection clipboard -in
    elif command -v xsel >/dev/null 2>&1; then
        xsel --clipboard --input
    else
        echo "mainframe-secret: no supported clipboard writer is installed" >&2
        return 1
    fi
}

store_value() {
    local name="$1" value="$2" existing new_line body
    if [[ -z "$value" ]]; then
        echo "mainframe-secret: refusing to register an empty value" >&2
        return 1
    fi
    case "$value" in
        *$'\n'*)
            echo "mainframe-secret: multiline values are not supported" >&2
            return 1
            ;;
    esac
    ensure_store
    acquire_lock || return 1
    trap 'release_lock' EXIT INT TERM
    existing=$(grep -v "^${name}=" "$SECRETS_FILE" 2>/dev/null || true)
    new_line=$(printf "%s='%s'" "$name" "$(escape_value "$value")")
    if [[ -n "$existing" ]]; then
        body="$existing
$new_line
"
    else
        body="$new_line
"
    fi
    write_store_atomically "$body"
    release_lock
    trap - EXIT INT TERM
    printf "mainframe-secret: registered '%s'\n" "$name"
}

cmd_set() {
    if [[ "$#" -lt 1 || "$#" -gt 2 ]]; then
        echo "Usage: mainframe-secret set NAME [--clipboard|--prompt]" >&2
        return 2
    fi
    validate_name "$1"
    local name="$1" mode="${2:---prompt}" value
    case "$mode" in
        --clipboard)
            value=$(read_clipboard) || return 1
            ;;
        --prompt)
            if [[ ! -t 0 ]]; then
                echo "mainframe-secret: protected prompt requires an interactive terminal" >&2
                return 1
            fi
            if ! IFS= read -r -s -p "Secret value for $name: " value; then
                printf '\n' >&2
                echo "mainframe-secret: protected input was cancelled" >&2
                return 1
            fi
            printf '\n' >&2
            ;;
        *)
            echo "mainframe-secret: values cannot be passed as command arguments; use --clipboard or --prompt" >&2
            return 1
            ;;
    esac
    store_value "$name" "$value"
}

cmd_get() {
    if [[ "$#" -ne 1 ]]; then
        echo "Usage: mainframe-secret get NAME" >&2
        return 2
    fi
    validate_name "$1"
    ensure_store
    local line value
    line=$(grep "^$1=" "$SECRETS_FILE" 2>/dev/null | tail -1 || true)
    if [[ -z "$line" ]]; then
        echo "mainframe-secret: no entry for '$1'" >&2
        return 1
    fi
    value="${line#*=}"
    case "$value" in
        \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    unescape_value "$value"
}

cmd_copy() {
    if [[ "$#" -ne 1 ]]; then
        echo "Usage: mainframe-secret copy NAME" >&2
        return 2
    fi
    local name="$1" value
    validate_name "$name"
    value=$(cmd_get "$name") || return 1
    printf '%s' "$value" | write_clipboard || return 1
    printf "mainframe-secret: copied '%s' to the clipboard\n" "$name"
}

cmd_del() {
    if [[ "$#" -ne 1 ]]; then
        echo "Usage: mainframe-secret del NAME" >&2
        return 2
    fi
    validate_name "$1"
    ensure_store
    acquire_lock || return 1
    trap 'release_lock' EXIT INT TERM
    if ! grep -q "^$1=" "$SECRETS_FILE" 2>/dev/null; then
        release_lock
        trap - EXIT INT TERM
        return 0
    fi
    local body
    body=$(grep -v "^$1=" "$SECRETS_FILE" 2>/dev/null || true)
    body="$body
"
    write_store_atomically "$body"
    release_lock
    trap - EXIT INT TERM
}

cmd_list() {
    ensure_store
    grep -E '^[A-Z_][A-Z0-9_]*=' "$SECRETS_FILE" 2>/dev/null \
        | cut -d= -f1 | sort -u || true
}

cmd_run() {
    local -a names=() values=()
    local name value index
    while [[ "$#" -gt 0 && "$1" != "--" ]]; do
        validate_name "$1"
        names+=("$1")
        shift
    done
    if [[ "${#names[@]}" -eq 0 || "$#" -eq 0 || "$1" != "--" ]]; then
        echo "Usage: mainframe-secret run NAME [NAME ...] -- COMMAND [ARG ...]" >&2
        return 2
    fi
    shift
    if [[ "$#" -eq 0 ]]; then
        echo "Usage: mainframe-secret run NAME [NAME ...] -- COMMAND [ARG ...]" >&2
        return 2
    fi
    for name in "${names[@]}"; do
        value=$(cmd_get "$name") || return 1
        values+=("$value")
    done
    ensure_store
    while IFS= read -r name; do
        [[ -n "$name" ]] && unset "$name"
    done < <(grep -E '^[A-Z_][A-Z0-9_]*=' "$SECRETS_FILE" 2>/dev/null \
        | cut -d= -f1 | sort -u || true)
    for ((index = 0; index < ${#names[@]}; index++)); do
        printf -v "${names[$index]}" '%s' "${values[$index]}"
        export "${names[$index]}"
    done
    exec -- "$@"
}

cmd_edit() {
    ensure_store
    : "${EDITOR:=${VISUAL:-vi}}"
    acquire_lock || return 1
    trap 'release_lock' EXIT INT TERM
    cp -p "$SECRETS_FILE" "$BACKUP_FILE" 2>/dev/null || true
    "$EDITOR" "$SECRETS_FILE"
    chmod 600 "$SECRETS_FILE" 2>/dev/null || true
    if ! bash -n "$SECRETS_FILE" 2>/dev/null; then
        echo "mainframe-secret: malformed store; backup preserved at $BACKUP_FILE" >&2
        return 1
    fi
    release_lock
    trap - EXIT INT TERM
}

cmd_help() {
    cat <<'EOF'
mainframe-secret — personal file-based secret command

Usage:
  mainframe-secret set NAME --clipboard
  mainframe-secret set NAME --prompt
  mainframe-secret copy NAME
  mainframe-secret get NAME
  mainframe-secret run NAME [NAME ...] -- COMMAND [ARG ...]
  mainframe-secret del NAME
  mainframe-secret list
  mainframe-secret edit
  mainframe-secret help

Names must match [A-Z_][A-Z0-9_]*.
Values are stored outside the MAINFRAME repository under the user's config
directory. Service descriptions and credential references belong in
MAINFRAME/shared/credentials/credentials-index.md.

Prefer `mainframe-secret run` for process-scoped delivery. Do not load the complete store
from shell startup files. Prefer `mainframe-secret set NAME --clipboard` for registration
and `mainframe-secret copy NAME` for user retrieval without terminal output.
EOF
}

case "${1:-help}" in
    set) shift; cmd_set "$@" ;;
    copy) shift; cmd_copy "$@" ;;
    get) shift; cmd_get "$@" ;;
    run) shift; cmd_run "$@" ;;
    del) shift; cmd_del "$@" ;;
    list) cmd_list ;;
    edit) cmd_edit ;;
    help|-h|--help) cmd_help ;;
    *) echo "mainframe-secret: unknown command '$1'; try 'mainframe-secret help'" >&2; exit 2 ;;
esac
