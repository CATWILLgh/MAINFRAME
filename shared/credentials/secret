#!/usr/bin/env bash
# secret — personal secrets manager.
#
# Stores KEY=VALUE entries in ~/.config/credentials/secrets.env (mode 0600).
# Cross-platform: macOS and Linux, no external dependencies.
#
# Usage:
#   secret set NAME VALUE   add or replace
#   secret get NAME         print value (use inline: $(secret get NAME))
#   secret run NAME -- CMD  expose selected names only to one child process
#   secret del NAME         delete
#   secret list             show names only
#   secret edit             open store in $EDITOR
#   secret help             this message

set -eu

SECRETS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/credentials"
SECRETS_FILE="$SECRETS_DIR/secrets.env"
BACKUP_FILE="$SECRETS_FILE.bak"
LOCKDIR="$SECRETS_DIR/.lock"

ensure_store() {
    if [ ! -d "$SECRETS_DIR" ]; then
        mkdir -p "$SECRETS_DIR"
        chmod 700 "$SECRETS_DIR"
    fi
    if [ ! -f "$SECRETS_FILE" ]; then
        ( umask 077; : > "$SECRETS_FILE" )
    fi
    chmod 600 "$SECRETS_FILE" 2>/dev/null || true
}

# mkdir is POSIX-atomic and present on stock macOS; flock(1) is not.
acquire_lock() {
    local n=0
    while ! mkdir "$LOCKDIR" 2>/dev/null; do
        local pid
        pid=$(cat "$LOCKDIR/pid" 2>/dev/null || true)
        if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
            # Stale lock from a dead process.
            rm -rf "$LOCKDIR"
            continue
        fi
        n=$((n + 1))
        if [ "$n" -gt 50 ]; then
            echo "secret: another instance holds the lock (waited 5s, giving up)" >&2
            return 1
        fi
        sleep 0.1
    done
    echo $$ > "$LOCKDIR/pid"
}

release_lock() {
    rm -rf "$LOCKDIR" 2>/dev/null || true
}

# Uppercase-only keeps the store visually distinct from local shell vars.
validate_name() {
    case "$1" in
        '')
            echo "secret: empty name" >&2; return 1 ;;
        [0-9]*)
            echo "secret: name '$1' cannot start with a digit" >&2; return 1 ;;
        *[!A-Z0-9_]*)
            echo "secret: name '$1' must match [A-Z_][A-Z0-9_]* (uppercase, digits, underscore)" >&2; return 1 ;;
    esac
}

# Single-quoted form is the only POSIX-portable way to round-trip arbitrary
# strings through `source`; embedded ' must become '\''.
escape_value() {
    printf "%s" "$1" | sed "s/'/'\\\\''/g"
}

unescape_value() {
    printf "%s" "$1" | sed "s/'\\\\''/'/g"
}

# POSIX rename(2) is atomic only on the same filesystem; cross-filesystem
# mv silently falls back to copy+unlink. Temp file must live in target's dir.
write_store_atomically() {
    local source_content="$1"
    local tmpfile
    tmpfile=$(mktemp "$SECRETS_DIR/.secrets.XXXXXX")
    chmod 600 "$tmpfile"
    trap 'rm -f "$tmpfile"; release_lock' EXIT INT TERM

    printf "%s" "$source_content" > "$tmpfile"

    if ! sh -n "$tmpfile" 2>/dev/null; then
        echo "secret: refusing to write malformed file (sh -n failed)" >&2
        rm -f "$tmpfile"
        return 1
    fi

    cp -p "$SECRETS_FILE" "$BACKUP_FILE" 2>/dev/null || true
    mv "$tmpfile" "$SECRETS_FILE"
    trap - EXIT INT TERM
}

cmd_set() {
    if [ "$#" -ne 2 ]; then
        echo "Usage: secret set NAME VALUE" >&2; return 2
    fi
    validate_name "$1"
    case "$2" in
        *$'\n'*)
            echo "secret: value contains a newline; multi-line values are not supported." >&2
            echo "        Use ~/.ssh/id_*, a PEM file, or a dedicated key store for multi-line content." >&2
            return 1
            ;;
    esac
    local name="$1"
    local value="$2"
    ensure_store
    acquire_lock || return 1
    trap 'release_lock' EXIT INT TERM

    local existing rest
    existing=$(grep -v "^${name}=" "$SECRETS_FILE" 2>/dev/null || true)
    local new_line
    new_line=$(printf "%s='%s'" "$name" "$(escape_value "$value")")

    local body
    if [ -n "$existing" ]; then
        body="$existing
$new_line
"
    else
        body="$new_line
"
    fi

    write_store_atomically "$body" || { release_lock; return 1; }
    release_lock
    trap - EXIT INT TERM
}

cmd_get() {
    if [ "$#" -ne 1 ]; then
        echo "Usage: secret get NAME" >&2; return 2
    fi
    validate_name "$1"
    ensure_store
    local line
    line=$(grep "^$1=" "$SECRETS_FILE" 2>/dev/null | tail -1 || true)
    if [ -z "$line" ]; then
        echo "secret: no entry for '$1'" >&2
        return 1
    fi
    local value="${line#*=}"
    # Strip surrounding single quotes.
    case "$value" in
        \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    unescape_value "$value"
}

cmd_del() {
    if [ "$#" -ne 1 ]; then
        echo "Usage: secret del NAME" >&2; return 2
    fi
    validate_name "$1"
    ensure_store
    acquire_lock || return 1
    trap 'release_lock' EXIT INT TERM

    if ! grep -q "^$1=" "$SECRETS_FILE" 2>/dev/null; then
        release_lock
        echo "secret: no entry for '$1' (nothing to delete)" >&2
        trap - EXIT INT TERM
        return 0
    fi

    local body
    body=$(grep -v "^$1=" "$SECRETS_FILE" 2>/dev/null || true)
    # Preserve trailing newline.
    body="$body
"

    write_store_atomically "$body" || { release_lock; return 1; }
    release_lock
    trap - EXIT INT TERM
}

cmd_list() {
    ensure_store
    grep -E "^[A-Z_][A-Z0-9_]*=" "$SECRETS_FILE" 2>/dev/null | cut -d= -f1 | sort -u || true
}

cmd_run() {
    local -a names=()
    local -a values=()
    while [ "$#" -gt 0 ] && [ "$1" != "--" ]; do
        validate_name "$1"
        names+=("$1")
        shift
    done
    if [ "${#names[@]}" -eq 0 ] || [ "$#" -eq 0 ] || [ "$1" != "--" ]; then
        echo "Usage: secret run NAME [NAME ...] -- COMMAND [ARG ...]" >&2
        return 2
    fi
    shift
    if [ "$#" -eq 0 ]; then
        echo "Usage: secret run NAME [NAME ...] -- COMMAND [ARG ...]" >&2
        return 2
    fi

    local name value
    for name in "${names[@]}"; do
        value=$(cmd_get "$name") || return 1
        values+=("$value")
    done

    # The legacy shell startup may already have exported every stored secret.
    # Remove those inherited entries before exporting only the requested set.
    ensure_store
    while IFS= read -r name; do
        [ -n "$name" ] && unset "$name"
    done < <(
        grep -E "^[A-Z_][A-Z0-9_]*=" "$SECRETS_FILE" 2>/dev/null \
            | cut -d= -f1 | sort -u || true
    )
    local index
    for ((index = 0; index < ${#names[@]}; index++)); do
        printf -v "${names[$index]}" '%s' "${values[$index]}"
        export "${names[$index]}"
    done
    exec -- "$@"
}

cmd_edit() {
    ensure_store
    : "${EDITOR:=${VISUAL:-vi}}"
    acquire_lock || return 1
    trap 'release_lock' EXIT INT TERM

    cp -p "$SECRETS_FILE" "$BACKUP_FILE" 2>/dev/null || true
    "$EDITOR" "$SECRETS_FILE"
    chmod 600 "$SECRETS_FILE" 2>/dev/null || true

    if ! sh -n "$SECRETS_FILE" 2>/dev/null; then
        echo "secret: file is now malformed (sh -n failed). Backup at $BACKUP_FILE" >&2
        release_lock
        trap - EXIT INT TERM
        return 1
    fi

    release_lock
    trap - EXIT INT TERM
}

cmd_help() {
    cat <<'EOF'
secret — personal secrets manager (file-based, cross-platform)

Usage:
  secret set NAME VALUE     add or replace a secret
  secret get NAME           print a value (use inline: $(secret get NAME))
  secret run NAME [NAME ...] -- COMMAND [ARG ...]
                            expose only those stored names to one child process
  secret del NAME           delete a secret
  secret list               show all names (no values)
  secret edit               open store in $EDITOR
  secret help               this message

Storage:  ~/.config/credentials/secrets.env  (mode 0600)
Backup:   ~/.config/credentials/secrets.env.bak  (mode 0600)
Index:    MAINFRAME/shared/credentials/credentials-index.md  (descriptions, no values)

After `secret set/edit`, open a new shell (or `source ~/.zshenv`) to
re-load secrets into the environment.

To load all secrets into the shell at startup, ensure ~/.zshenv contains:
  [ -f ~/.config/credentials/secrets.env ] && set -a && . ~/.config/credentials/secrets.env && set +a

install.sh from MAINFRAME hub adds this line idempotently.
EOF
}

case "${1:-help}" in
    set)   shift; cmd_set "$@" ;;
    get)   shift; cmd_get "$@" ;;
    run)   shift; cmd_run "$@" ;;
    del)   shift; cmd_del "$@" ;;
    list)  cmd_list ;;
    edit)  cmd_edit ;;
    help|-h|--help)  cmd_help ;;
    *)     echo "secret: unknown command '$1' — try 'secret help'" >&2; exit 2 ;;
esac
